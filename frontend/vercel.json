{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "searchtern.ksaif.dev" }],
      "destination": "https://searchtern.net/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.searchtern.net" }],
      "destination": "https://searchtern.net/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/jobs", "destination": "/index.html" },
    { "source": "/jobs/:id", "destination": "/api/og?id=:id" },
    { "source": "/tracker", "destination": "/index.html" },
    { "source": "/resume", "destination": "/index.html" },
    { "source": "/auth", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/sitemap.xml", "destination": "https://api.searchtern.net/sitemap.xml" }
  ]
}
