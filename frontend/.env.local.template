# Frontend API Key matching the API_KEY set in backend/.env
VITE_API_KEY=your_secure_random_string_here

# Optional. Leave unset to use the same-origin /backend path, which works in
# both dev (vite proxy -> 127.0.0.1:8000) and prod (vercel -> API host).
# VITE_API_URL=http://127.0.0.1:8000

# Optional: Supabase configuration if not running purely locally
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
