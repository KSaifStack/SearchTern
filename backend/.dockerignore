# load_dotenv() does not override real environment variables, so anything baked
# into the image here wins over the DATABASE_URL / API_KEY the host injects.
# That silently points a new deployment at the old database.
.env
.env.*
!.env.template

__pycache__/
*.pyc
*.db

# Runtime snapshot artifact: regenerated on every in-process scrape, so baking
# a stale 10MB copy into the image only adds deploy-time bloat.
recent.jobs.json

test*.py
