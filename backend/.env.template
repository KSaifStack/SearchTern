# Backend API Key (must match VITE_API_KEY in frontend/.env.local)
API_KEY=your_secure_random_string_here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/searchtern

# ── Agent Bridge (Hermes / Claude Code / opencode) ────────────────────────────
# Agents authenticate with per-user keys that users generate inside SearchTern
# (Settings → AI Agents). No backend key needed here.
#
# Optional — lets agents READ the user's tracker via Supabase (tracked_jobs table).
# Without these, /agent/tracker returns an empty jobs list with a note.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
