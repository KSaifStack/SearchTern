[Unit]
Description=SearchTern Backend (FastAPI)
After=network.target

[Service]
User=root
# Change this to the path where SearchTern is located on your Fedora Server
WorkingDirectory=/opt/SearchTernBase/backend
Environment="PATH=/opt/SearchTernBase/backend/venv/bin"
# Assuming you set up a virtual environment in /opt/SearchTernBase/backend/venv
ExecStart=/opt/SearchTernBase/backend/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
