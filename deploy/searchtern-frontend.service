[Unit]
Description=SearchTern Frontend (Vite/Serve)
After=network.target

[Service]
User=root
# Change this to the path where SearchTern is located on your Fedora Server
WorkingDirectory=/opt/SearchTernBase/frontend
# Ensure node/npm are in the path. You may need to specify the absolute path to npx.
ExecStart=/usr/bin/npx serve -s dist -l 5173

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
